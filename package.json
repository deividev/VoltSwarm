{
  "name": "voltswarm",
  "version": "0.30.12",
  "description": "Voltswarm - an industrial robot bullet heaven.",
  "type": "module",
  "main": "electron/dist/main.js",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "preinstall": "node tools/check-package-manager.mjs",
    "dev": "vite",
    "prebuild": "pnpm run audio:generate",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:build": "tsc -p tsconfig.electron.json && node tools/write-electron-cjs-package.cjs",
    "electron:start": "pnpm run build && pnpm run electron:build && electron .",
    "prepackage": "node tools/check-release-flags.mjs",
    "package": "pnpm run build && pnpm run electron:build && pnpm run check:release-bundle && electron-builder",
    "package:dir": "pnpm run check:release-flags && pnpm run build && pnpm run electron:build && pnpm run check:release-bundle && electron-builder --dir",
    "check:release-flags": "node tools/check-release-flags.mjs",
    "check:release-bundle": "node tools/check-release-bundle.mjs",
    "test": "pnpm run electron:build && node --experimental-strip-types --test tools/version-format.test.cjs tools/safe-save.test.cjs tools/playtest-reset.test.cjs tools/package-guard.test.cjs tools/achievement-store.test.cjs tools/achievements.test.mjs tools/telemetry-client.test.cjs tools/display-settings.test.mjs tools/map-flow.test.mjs tools/defeat-transition.test.mjs tools/characters.test.mjs tools/character-preview-state.test.mjs tools/chest-reel.test.mjs tools/audio-selection.test.mjs tools/stat-units.test.mjs tools/sustain-balance.test.mjs tools/regen-pressure.test.mjs tools/contracts.test.mjs tools/final-boss.test.mjs tools/slagcaster-model.test.mjs",
    "test:all": "pnpm test && pnpm run test:defeat-runtime && pnpm run test:character-portrait-browser && pnpm run test:contracts-browser && pnpm run test:chest-reel-browser && pnpm run test:smoke",
    "test:smoke": "node tools/smoke-run.mjs",
    "test:telemetry": "pnpm run electron:build && node --test tools/telemetry-client.test.cjs",
    "test:version": "node --test tools/version-format.test.cjs",
    "test:display": "node --test tools/display-settings.test.mjs",
    "test:safe-save": "pnpm run electron:build && node --test tools/safe-save.test.cjs",
    "test:playtest-reset": "pnpm run electron:build && node --test tools/playtest-reset.test.cjs",
    "test:package-guard": "node --test tools/package-guard.test.cjs tools/release-surface.test.mjs",
    "test:achievements": "pnpm run electron:build && node --experimental-strip-types --test tools/achievement-store.test.cjs tools/achievements.test.mjs",
    "test:map-flow": "node --experimental-strip-types --test tools/map-flow.test.mjs",
    "test:defeat-transition": "node --experimental-strip-types --test tools/defeat-transition.test.mjs",
    "test:defeat-runtime": "node tools/defeat-runtime-check.mjs",
    "test:final-boss": "node --test tools/final-boss.test.mjs",
    "test:finale-runtime": "node tools/finale-runtime-check.mjs",
    "test:characters": "node --test tools/characters.test.mjs",
    "test:character-preview": "node --test tools/character-preview-state.test.mjs",
    "test:character-portrait-browser": "node tools/character-portrait-browser.test.mjs",
    "test:chest-reel": "node --test tools/chest-reel.test.mjs",
    "test:chest-reel-browser": "node tools/chest-reel-browser.test.mjs",
    "test:audio-selection": "node --test tools/audio-selection.test.mjs tools/audio-music-transition.test.mjs tools/audio-runtime-pack.test.mjs tools/ui-audio.test.mjs",
    "test:stat-units": "node --test tools/stat-units.test.mjs",
    "test:sustain-balance": "node --experimental-strip-types --test tools/sustain-balance.test.mjs",
    "test:regen-pressure": "node --experimental-strip-types --test tools/regen-pressure.test.mjs",
    "test:contracts": "node --test tools/contracts.test.mjs",
    "test:contracts-browser": "node tools/contracts-browser.test.mjs",
    "stats": "node tools/run-stats.mjs",
    "reset:profile": "node tools/reset-profile.mjs",
    "audio:generate": "node tools/audio/rebuild-runtime-pack.mjs",
    "audio:validate": "node tools/audio/validate-runtime-pack.mjs",
    "audio:mix-sheet": "node tools/audio/create-mix-calibration.mjs",
    "audio:foundation-check": "node tools/audio/foundation-check.mjs",
    "benchmark:audio": "node tools/benchmark-audio-electron.mjs",
    "test:audio-benchmark-policy": "node --test tools/audio-benchmark-policy.test.mjs",
    "benchmark:stress": "node tools/perf-stress.mjs",
    "test:packaged": "node tools/packaged-run-check.mjs"
  },
  "author": "David Seco Diaz",
  "license": "MIT",
  "dependencies": {
    "steamworks.js": "0.4.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "electron-builder-squirrel-windows": "26.15.3"
    }
  },
  "build": {
    "appId": "com.davidseco.voltswarm",
    "productName": "Voltswarm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "package.json",
      "!node_modules/three/**",
      "!node_modules/undici-types/**",
      "!node_modules/steamworks.js/dist/linux64/**",
      "!node_modules/steamworks.js/dist/osx/**",
      "!node_modules/steamworks.js/dist/win64/*.lib",
      "!node_modules/steamworks.js/*.d.ts",
      "!node_modules/steamworks.js/README.md",
      "!node_modules/steamworks.js/LICENSE",
      "!node_modules/@types/**",
      "!dist/assets/2d/ref-field-engineer-side-v1.png",
      "!dist/assets/2d/ref-final-boss-front-v2.png",
      "!dist/assets/2d/ref-final-boss-side-v2.png",
      "!dist/assets/2d/ref-final-boss-back-v2.png",
      "!dist/assets/2d/ref-sparkrunner-front-v5.png",
      "!dist/assets/2d/ref-sparkrunner-side-v3.png",
      "!dist/assets/2d/ref-sparkrunner-back-v5.png",
      "!dist/assets/2d/ref-tesla-titan-front.png",
      "!dist/assets/2d/ref-tesla-titan-side-v1.png",
      "!dist/assets/2d/ref-tesla-titan-back-v1.png",
      "!dist/assets/2d/ref-volt-warden-front-v2.png",
      "!dist/assets/2d/prop-canister-front-v1.png",
      "!dist/assets/2d/prop-foundry-tower-*.png",
      "!dist/assets/2d/prop-foundry-stack-front-v1.png",
      "!dist/assets/2d/prop-foundry-stack-front-v2.png",
      "!dist/assets/2d/prop-foundry-stack-side-v1.png",
      "!dist/assets/2d/prop-foundry-stack-back-v1.png"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/dist/win64/*.node",
      "node_modules/steamworks.js/dist/win64/*.dll"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "afterPack": "./tools/check-asar-payload.mjs"
  }
}
