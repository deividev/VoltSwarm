{
  "name": "voltswarm",
  "version": "0.1.0",
  "description": "Voltswarm - an industrial robot bullet heaven.",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:build": "tsc -p tsconfig.electron.json && node tools/write-electron-cjs-package.cjs",
    "electron:start": "npm run build && npm run electron:build && electron .",
    "package": "npm run build && npm run electron:build && electron-builder",
    "package:dir": "npm run build && npm run electron:build && electron-builder --dir"
  },
  "author": "David Seco Diaz",
  "license": "MIT",
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/three": "^0.169.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.davidseco.voltswarm",
    "productName": "Voltswarm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
