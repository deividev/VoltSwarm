{
  "name": "voltswarm",
  "version": "0.13.32-demo",
  "description": "Voltswarm - an industrial robot bullet heaven.",
  "type": "module",
  "main": "electron/dist/main.js",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "preinstall": "node tools/check-package-manager.mjs",
    "dev": "vite",
    "prebuild": "pnpm run audio:generate",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:build": "tsc -p tsconfig.electron.json && node tools/write-electron-cjs-package.cjs",
    "electron:start": "pnpm run build && pnpm run electron:build && electron .",
    "package": "pnpm run check:release-flags && pnpm run build && pnpm run electron:build && electron-builder",
    "package:dir": "pnpm run check:release-flags && pnpm run build && pnpm run electron:build && electron-builder --dir",
    "check:release-flags": "node tools/check-release-flags.mjs",
    "test": "pnpm run electron:build && node --experimental-strip-types --test tools/version-format.test.cjs tools/demo-build.test.cjs tools/demo-mission.test.mjs tools/safe-save.test.cjs tools/playtest-reset.test.cjs tools/telemetry-client.test.cjs tools/display-settings.test.mjs tools/defeat-transition.test.mjs tools/characters.test.mjs tools/character-preview-state.test.mjs tools/chest-reel.test.mjs tools/audio-selection.test.mjs tools/stat-units.test.mjs tools/sustain.test.mjs tools/regen-pressure.test.mjs tools/contracts.test.mjs",
    "test:all": "pnpm test && pnpm run test:defeat-runtime && pnpm run test:character-portrait-browser && pnpm run test:chest-reel-browser && pnpm run test:smoke",
    "test:smoke": "node tools/smoke-run.mjs",
    "test:telemetry": "pnpm run electron:build && node --test tools/telemetry-client.test.cjs",
    "test:version": "node --test tools/version-format.test.cjs",
    "test:display": "node --test tools/display-settings.test.mjs",
    "test:safe-save": "pnpm run electron:build && node --test tools/safe-save.test.cjs",
    "test:defeat-transition": "node --experimental-strip-types --test tools/defeat-transition.test.mjs",
    "test:defeat-runtime": "node tools/defeat-runtime-check.mjs",
    "test:demo": "node --test tools/demo-build.test.cjs tools/demo-mission.test.mjs tools/check-asar-payload.test.mjs tools/version-format.test.cjs",
    "test:demo-mission": "node --test tools/demo-mission.test.mjs",
    "test:playtest-reset": "pnpm run electron:build && node --test tools/playtest-reset.test.cjs",
    "test:characters": "node --test tools/characters.test.mjs",
    "test:character-preview": "node --test tools/character-preview-state.test.mjs",
    "test:character-portrait-browser": "node tools/character-portrait-browser.test.mjs",
    "test:chest-reel": "node --test tools/chest-reel.test.mjs",
    "test:chest-reel-browser": "node tools/chest-reel-browser.test.mjs",
    "test:audio-selection": "node --test tools/audio-selection.test.mjs",
    "test:regen-pressure": "node --test tools/regen-pressure.test.mjs",
    "test:contracts": "node --test tools/contracts.test.mjs",
    "test:stat-units": "node --test tools/stat-units.test.mjs",
    "test:sustain": "node --test tools/sustain.test.mjs",
    "stats": "node tools/run-stats.mjs",
    "reset:profile": "node tools/reset-profile.mjs",
    "audio:generate": "node tools/audio/generate.mjs",
    "audio:validate": "node tools/audio/validate.mjs",
    "audio:foundation-check": "node tools/audio/foundation-check.mjs",
    "benchmark:audio": "node tools/benchmark-audio-electron.mjs",
    "test:packaged": "node tools/packaged-run-check.mjs"
  },
  "author": "David Seco Diaz",
  "license": "MIT",
  "voltswarmBuild": {
    "flavor": "demo",
    "allowedMaps": [
      "scrapyard"
    ],
    "appId": "com.davidseco.voltswarm.demo",
    "productName": "Voltswarm Demo",
    "userDataDirectory": "Voltswarm Demo",
    "fullGameSteamAppId": 4979220,
    "fullGameSteamUrl": "https://store.steampowered.com/app/4979220/Voltswarm/"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.19.21",
    "@types/three": "^0.169.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "buildVersion": "0.13.32.0",
    "appId": "com.davidseco.voltswarm.demo",
    "productName": "Voltswarm Demo",
    "directories": {
      "output": "release-demo-map1"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "package.json",
      "!node_modules/three/**",
      "!dist/assets/audio/sfx/**",
      "!dist/assets/2d/ref-field-engineer-side-v1.png",
      "!dist/assets/2d/ref-final-boss-front-v2.png",
      "!dist/assets/2d/ref-final-boss-side-v2.png",
      "!dist/assets/2d/ref-final-boss-back-v2.png",
      "!dist/assets/2d/ref-hazard-marshal-front-v1.png",
      "!dist/assets/2d/ref-hazard-marshal-side-v1.png",
      "!dist/assets/2d/ref-hazard-marshal-back-v1.png",
      "!dist/assets/2d/ref-sparkrunner-front-v5.png",
      "!dist/assets/2d/ref-sparkrunner-side-v3.png",
      "!dist/assets/2d/ref-sparkrunner-back-v5.png",
      "!dist/assets/2d/ref-tesla-titan-side-v1.png",
      "!dist/assets/2d/ref-tesla-titan-back-v1.png",
      "!dist/assets/2d/ref-volt-warden-front-v2.png",
      "!dist/assets/audio/prototypes/merchant-arrival.wav",
      "!dist/assets/audio/prototypes/player-hit-1.wav",
      "!dist/assets/audio/prototypes/player-hit-2.wav",
      "!dist/assets/audio/prototypes/player-hit-b-1.wav",
      "!dist/assets/audio/prototypes/player-hit-b-2.wav",
      "!dist/assets/audio/prototypes/run-victory.wav"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Voltswarm-Demo-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Voltswarm-Demo-${version}-portable.${ext}"
    },
    "afterPack": "./tools/check-asar-payload.mjs"
  }
}
