# Dependencies
node_modules/

# This project is pnpm-only (see tools/check-package-manager.mjs). A tracked npm
# lockfile alongside a pnpm-installed tree is what once left node_modules with no
# .bin at all, so the build died on "tsc is not recognized". pnpm-lock.yaml IS
# tracked; these must never come back.
package-lock.json
yarn.lock

# Build outputs
dist/
electron/dist/
release/

# Logs
*.log
npm-debug.log*

# Editor/OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Env
.env
.env.local

# Skill registry cache (regenerated locally, not source of truth)
.atl/.skill-registry.cache.json

# ─────────────────────────────────────────────────────────────────────────
# Imágenes y assets del juego — SOLO LOCAL (mantienen el repo liviano; ~1.8GB
# de art/ + assets no entran al repo). Decisión del usuario 2026-07-12.
# ⚠️ Consecuencia: un clon fresco del repo NO tendrá los assets → no correrá
#    ni se empaquetará sin restaurarlos desde el backup local. Es intencional.
# ─────────────────────────────────────────────────────────────────────────
# Carpetas de assets
/art/
/public/assets/
/public/fonts/
/assets/
/tmp/
/build/
