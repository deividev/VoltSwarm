# Dependencies
node_modules/

# This project is pnpm-only (see tools/check-package-manager.mjs). A tracked npm
# lockfile alongside a pnpm-installed tree is what once left node_modules with no
# .bin at all, so the build died on "tsc is not recognized". pnpm-lock.yaml IS
# tracked; these must never come back.
package-lock.json
yarn.lock

# Build outputs
dist/
electron/dist/
release/

# Logs
*.log
npm-debug.log*

# Editor/OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Env
.env
.env.local

# Skill registry cache (regenerated locally, not source of truth)
.atl/.skill-registry.cache.json

# ─────────────────────────────────────────────────────────────────────────
# Imágenes y assets del juego — SOLO LOCAL (mantienen el repo liviano; ~1.8GB
# de art/ + assets no entran al repo). Decisión del usuario 2026-07-12.
# ⚠️ Consecuencia: un clon fresco del repo NO tendrá los assets → no correrá
#    ni se empaquetará sin restaurarlos desde el backup local. Es intencional.
# ─────────────────────────────────────────────────────────────────────────
# Carpetas de assets
/art/
/public/assets/
/public/fonts/
/assets/
/tmp/
/build/
# Media suelta en cualquier parte (red de seguridad)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.ico
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.ogg
*.woff2

# Canonical accepted audio masters are the deliberate binary exception. The
# runtime pack is reconstructed byte-for-byte from this small, hash-pinned
# vault, so a normal clone must contain it even though other media stays local.
!/audio-masters/
!/audio-masters/runtime/
!/audio-masters/runtime/*.wav
!/audio-masters/runtime/*.mp3
!/audio-masters/runtime/*.ogg

# Shipped Overclocker runtime sheets are the minimal exception to the local-only
# asset policy. Parent directories must be reopened before exact file negations.
!/public/assets/
/public/assets/*
!/public/assets/2d/
/public/assets/2d/*
!/public/assets/2d/ref-overclocker-front-v1.png
!/public/assets/2d/ref-overclocker-side-v1.png
!/public/assets/2d/ref-overclocker-back-v1.png
!/public/assets/2d/ref-overclocker-top-v1.png
